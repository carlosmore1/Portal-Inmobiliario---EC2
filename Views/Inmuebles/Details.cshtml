@model PortalInmobiliario.Models.Inmueble
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Detalle";
}

<h2>@Model.Titulo</h2>

<!-- Feedback en la misma vista -->
@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<div class="row g-3">
    <div class="col-md-6">
        @if (!string.IsNullOrWhiteSpace(Model.Imagen))
        {
            <img src="@Model.Imagen" class="img-fluid rounded" alt="@Model.Titulo" />
        }
    </div>
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Código</dt><dd class="col-sm-8">@Model.Codigo</dd>
            <dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.Tipo</dd>
            <dt class="col-sm-4">Ciudad</dt><dd class="col-sm-8">@Model.Ciudad</dd>
            <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@Model.Direccion</dd>
            <dt class="col-sm-4">Dorms/Baños</dt><dd class="col-sm-8">@Model.Dormitorios / @Model.Banos</dd>
            <dt class="col-sm-4">Área</dt><dd class="col-sm-8">@Model.MetrosCuadrados m²</dd>
            <dt class="col-sm-4">Precio</dt><dd class="col-sm-8">S/ @Model.Precio</dd>
        </dl>

        @if (SignInManager.IsSignedIn(User))
        {
            <!-- Agendar visita (mismo detalle) -->
            <h5>Agendar visita</h5>
            <form asp-controller="Visitas" asp-action="Agendar" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="InmuebleId" value="@Model.Id" />

                <div class="col-md-6">
                    <label class="form-label">Fecha inicio</label>
                    <input class="form-control" type="datetime-local" name="FechaInicio" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Fecha fin</label>
                    <input class="form-control" type="datetime-local" name="FechaFin" required />
                </div>
                <div class="col-12">
                    <label class="form-label">Notas (opcional)</label>
                    <textarea class="form-control" name="Notas" rows="2" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit">Solicitar visita</button>
                </div>
            </form>

            <hr />

            <!-- Reservar (48h) solo si NO hay reserva activa -->
            @if (ViewBag.HasReservaActiva == true)
            {
                <div class="alert alert-warning mb-0">Este inmueble ya tiene una reserva activa.</div>
            }
            else
            {
                <form asp-controller="Reservas" asp-action="Reservar" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="inmuebleId" value="@Model.Id" />
                    <button class="btn btn-outline-success" type="submit">Reservar ahora (48h)</button>
                </form>
            }
        }
        else
        {
            <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">
                Inicia sesión para agendar o reservar
            </a>
        }
    </div>
</div>
